
library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.STD_LOGIC_UNSIGNED.ALL;

entity mod25 is
Port (
    rst : in STD_LOGIC;
    pr  : in STD_LOGIC;
    clk : in STD_LOGIC;
    dir : in STD_LOGIC;
    Q   : out STD_LOGIC_VECTOR(4 downto 0)
);
end mod25;

architecture behavior of mod25 is

signal temp : STD_LOGIC_VECTOR(4 downto 0) := "00000";

begin

process(rst, pr, clk)
begin
    if rst = '1' then
        temp <= "00000";

    elsif pr = '1' then
        temp <= "11111";

    elsif falling_edge(clk) then

        if dir = '1' then
            -- UP counting
            if temp < 24 then
                temp <= temp + 1;
            else
                temp <= "00000";
            end if;

        else
            -- DOWN counting
            if temp > 7 then
                temp <= temp - 1;
            else
                temp <= "11111";
            end if;

        end if;
    end if;
end process;

Q <= temp;

end behavior;



