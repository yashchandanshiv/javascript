end component;

signal rst : STD_LOGIC := '0';
signal pr  : STD_LOGIC := '0';
signal clk : STD_LOGIC := '0';
signal dir : STD_LOGIC := '0';
signal Q   : STD_LOGIC_VECTOR(4 downto 0);

begin

-- Connect counter
uut: mod25 PORT MAP (
    rst => rst,
    pr  => pr,
    clk => clk,
    dir => dir,
    Q   => Q
);

-- Clock generation
clk_process: process
begin
    clk <= '0';
    wait for 5 ns;
    clk <= '1';
    wait for 5 ns;
end process;

-- Direction control
dir_process: process
begin
    dir <= '0';
    wait for 320 ns;
    dir <= '1';
    wait for 320 ns;
    dir <= '0';
    wait;
end process;

-- Reset
rst_process: process
begin
    wait for 680 ns;
    rst <= '1';
    wait for 40 ns;
    rst <= '0';
    wait;
end process;

-- Preset
pr_process: process
begin
    wait for 750 ns;
    pr <= '1';
    wait for 40 ns;
    pr <= '0';
    wait;
end process;

end behavior;



