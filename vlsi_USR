#Design Code



library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity UNI_Shift_Register is
Port (
    rst  : in STD_LOGIC;
    clk  : in STD_LOGIC;
    Sin  : in STD_LOGIC;
    mode : in STD_LOGIC_VECTOR(1 downto 0);
    Pin  : in STD_LOGIC_VECTOR(3 downto 0);
    Sout : out STD_LOGIC;
    Pout : out STD_LOGIC_VECTOR(3 downto 0)
);
end UNI_Shift_Register;

architecture behavior of UNI_Shift_Register is

signal temp : STD_LOGIC_VECTOR(3 downto 0) := "0000";

begin

process(rst, clk)
begin
    if rst = '1' then
        temp <= "0000";
        Pout <= "0000";
        Sout <= '0';

    elsif falling_edge(clk) then
        case mode is
            when "00" =>
                temp <= temp(2 downto 0) & Sin;
                Sout <= temp(3);
                Pout <= "0000";

            when "01" =>
                temp <= temp(2 downto 0) & Sin;
                Pout <= temp;
                Sout <= '0';

            when "10" =>
                temp <= Pin;
                Sout <= '0';
                Pout <= "0000";

            when others =>
                Pout <= Pin;
                Sout <= '0';

        end case;
    end if;
end process;

end behavior;


