signal rst  : STD_LOGIC := '0';
signal clk  : STD_LOGIC := '1';
signal Sin  : STD_LOGIC := '0';
signal mode : STD_LOGIC_VECTOR(1 downto 0) := "00";
signal Pin  : STD_LOGIC_VECTOR(3 downto 0) := "1010";

signal Sout : STD_LOGIC;
signal Pout : STD_LOGIC_VECTOR(3 downto 0);

begin

uut: UNI_Shift_Register PORT MAP (
    rst => rst,
    clk => clk,
    Sin => Sin,
    mode => mode,
    Pin => Pin,
    Sout => Sout,
    Pout => Pout
);

-- Clock generation
clk_process: process
begin
    clk <= NOT clk;
    wait for 5 ns;
end process;

-- Mode selection
stim_proc_mode: process
begin
    mode <= "00";
    wait for 80 ns;

    mode <= "01";
    wait for 50 ns;

    mode <= "10";
    wait for 50 ns;

    mode <= "11";
    wait for 20 ns;

    wait;
end process;

-- Serial input
stim_proc_Sin: process
begin
    Sin <= '0';
    wait for 10 ns;

    Sin <= '1';
    wait for 10 ns;

    Sin <= '0';
    wait for 10 ns;

    Sin <= '1';
    wait for 10 ns;

    Sin <= '0';
    wait;
end process;

-- Reset
stim_proc_rst: process
begin
    rst <= '0';
    wait for 122.5 ns;

    rst <= '1';
    wait for 5 ns;

    rst <= '0';
    wait;
end process;

end behavior;





