library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.STD_LOGIC_ARITH.ALL;

entity fifo_tb is
end fifo_tb;

architecture behavior of fifo_tb is

signal clk, reset, enr, enw : STD_LOGIC := '0';
signal empty, full : STD_LOGIC;

signal data_in, data_out : STD_LOGIC_VECTOR(7 downto 0);

constant clk_period : time := 10 ns;
constant depth : integer := 16;

begin

-- FIFO connection
uut: entity work.fifo
generic map(depth => depth)
port map(clk, reset, enr, enw, data_in, data_out, empty, full);

-- CLOCK
clk_process: process
begin
    clk <= '0';
    wait for 5 ns;

    clk <= '1';
    wait for 5 ns;
end process;

-- INPUT TESTING
stim_proc: process
begin

    -- RESET
    reset <= '1';
    wait for clk_period;

    reset <= '0';
    wait for clk_period*3;

    -- WRITE 10 VALUES
    enw <= '1';
    enr <= '0';

    for i in 1 to 10 loop
        data_in <= conv_std_logic_vector(i, 8);
        wait for clk_period;
    end loop;

    -- READ 4 VALUES
    enw <= '0';
    enr <= '1';
    wait for clk_period*4;

    -- WAIT
    enr <= '0';
    wait for clk_period*10;

    -- WRITE 10 MORE VALUES
    enw <= '1';
    enr <= '0';

    for i in 11 to 20 loop
        data_in <= conv_std_logic_vector(i, 8);
        wait for clk_period;
    end loop;

    -- READ REMAINING DATA
    enw <= '0';
    enr <= '1';
    wait for clk_period*16;

    enr <= '0';

    wait;

end process;

end behavior;




