library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity ALU_4bit is
Port (
    A : in STD_LOGIC_VECTOR(3 downto 0);
    B : in STD_LOGIC_VECTOR(3 downto 0);
    F : in STD_LOGIC_VECTOR(2 downto 0);
    Y : out STD_LOGIC_VECTOR(3 downto 0);
    C_B : out STD_LOGIC
);
end ALU_4bit;

architecture ALU_4bit_arch of ALU_4bit is

signal result : unsigned(4 downto 0);

begin

process(A, B, F)
begin
    case F is

        when "000" =>
            result <= '0' & (unsigned(A) AND unsigned(B));

        when "001" =>
            result <= '0' & (unsigned(A) NAND unsigned(B));

        when "010" =>
            result <= '0' & (unsigned(A) OR unsigned(B));

        when "011" =>
            result <= '0' & (unsigned(A) XOR unsigned(B));

        when "100" =>
            result <= '0' & (unsigned(A) XNOR unsigned(B));

        when "101" =>
            result <= '0' & (unsigned(A) NOR unsigned(B));

        when "110" =>
            result <= ('0' & unsigned(A)) + ('0' & unsigned(B));

        when others =>
            result <= ('0' & unsigned(A)) - ('0' & unsigned(B));

    end case;
end process;

Y <= std_logic_vector(result(3 downto 0));
C_B <= result(4);

end ALU_4bit_arch;



